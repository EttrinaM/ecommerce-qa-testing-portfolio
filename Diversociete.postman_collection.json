        {
          "name": "DNU-Retrieve specific transactions by email",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();\r",
                  "const documents = response.documents || [];\r",
                  "\r",
                  "let searchEmail = '';\r",
                  "try {\r",
                  "  const url = new URL(pm.request.url.toString());\r",
                  "  searchEmail = decodeURIComponent(url.searchParams.get('customerEmail') || '').toLowerCase().trim();\r",
                  "} catch (e) {\r",
                  "  console.log(\"❌ URL parsing error:\", e);\r",
                  "}\r",
                  "\r",
                  "console.log(\"🔍 Looking for email:\", searchEmail);\r",
                  "\r",
                  "// Find matching document by email\r",
                  "const matched = documents.find(doc =>\r",
                  "  doc.customerEmail?.toLowerCase().trim() === searchEmail\r",
                  ");\r",
                  "\r",
                  "if (matched) {\r",
                  "  console.log(\"✅ Matched Document Found:\", matched);\r",
                  "  pm.collectionVariables.set(\"matchedTransactionId\", matched.id);\r",
                  "  pm.collectionVariables.set(\"matchedSalesOrderId\", matched.salesOrderId);\r",
                  "  pm.collectionVariables.set(\"matchedCustomerEmail\", matched.customerEmail);\r",
                  "  pm.collectionVariables.set(\"matchedTransDocument\", JSON.stringify(matched, null, 2));\r",
                  "} else {\r",
                  "  console.log(\"❌ No match found for:\", searchEmail);\r",
                  "  [\"matchedTransactionId\", \"matchedSalesOrderId\", \"matchedCustomerEmail\", \"matchedTransDocument\"]\r",
                  "    .forEach(key => pm.collectionVariables.unset(key));\r",
                  "}\r",
                  ""
                ],
                "type": "text/javascript",
                "packages": {}
              }
            }
          ],
