        {
          "name": "Retrieving specific information from all orders",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();\r",
                  "const orders = response.result || [];\r",
                  "\r",
                  "let searchEmail = '';\r",
                  "let searchId = '';\r",
                  "let searchOrderNumber = '';\r",
                  "\r",
                  "try {\r",
                  "  const url = new URL(pm.request.url.toString());\r",
                  "  searchEmail = decodeURIComponent(url.searchParams.get('customerEmail') || '').toLowerCase().trim();\r",
                  "  searchId = decodeURIComponent(url.searchParams.get('id') || '').trim();\r",
                  "  searchOrderNumber = decodeURIComponent(url.searchParams.get('orderNumber') || '').trim();\r",
                  "} catch (e) {\r",
                  "  console.log(\"❌ URL parsing error:\", e);\r",
                  "}\r",
                  "\r",
                  "console.log(\"🔍 Searching by:\", {\r",
                  "  email: searchEmail,\r",
                  "  id: searchId,\r",
                  "  orderNumber: searchOrderNumber\r",
                  "});\r",
                  "\r",
                  "// Find the matching order\r",
                  "const matched = orders.find(order => {\r",
                  "  const emailMatch = searchEmail && order.customerEmail?.toLowerCase().trim() === searchEmail;\r",
                  "  const idMatch = searchId && order.id === searchId;\r",
                  "  const orderMatch = searchOrderNumber && order.orderNumber === searchOrderNumber;\r",
                  "  return emailMatch || idMatch || orderMatch;\r",
                  "});\r",
                  "\r",
                  "if (matched) {\r",
                  "  console.log(\"Matched Order Found:\", matched);\r",
                  "  pm.collectionVariables.set(\"matchedOrderId\", matched.id);\r",
                  "  pm.collectionVariables.set(\"matchedOrderNumber\", matched.orderNumber);\r",
                  "  pm.collectionVariables.set(\"matchedOrderEmail\", matched.customerEmail);\r",
                  "  pm.collectionVariables.set(\"matchedOrder\", JSON.stringify(matched, null, 2));\r",
                  "} else {\r",
                  "  console.log(\"❌ No matching order found.\");\r",
                  "  [\"matchedOrderId\", \"matchedOrderNumber\", \"matchedOrderEmail\", \"matchedOrder\"]\r",
                  "    .forEach(key => pm.collectionVariables.unset(key));\r",
                  "}\r",
                  ""
                ],
                "type": "text/javascript",
                "packages": {}
              }
            }
          ],
