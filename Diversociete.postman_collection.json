    {
      "name": "Profiles API",
      "item": [
        {
          "name": "Retrieve all profiles",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();\r",
                  "const profiles = response.profiles || [];\r",
                  "\r",
                  "const requestUrl = pm.request.url.toString();\r",
                  "let emailParam = '';\r",
                  "try {\r",
                  "  const url = new URL(requestUrl);\r",
                  "  emailParam = url.searchParams.get('customerEmail') || '';\r",
                  "  emailParam = decodeURIComponent(emailParam).toLowerCase().trim();\r",
                  "  console.log(\"Searching for email:\", emailParam);\r",
                  "} catch (e) {\r",
                  "  console.log(\"URL parsing error:\", e);\r",
                  "}\r",
                  "\r",
                  "let matched = null;\r",
                  "\r",
                  "for (let p of profiles) {\r",
                  "  if (!p.email) continue;\r",
                  "  const profileEmail = p.email.toLowerCase().trim();\r",
                  "  if (profileEmail === emailParam) {\r",
                  "    matched = p;\r",
                  "    break;\r",
                  "  }\r",
                  "}\r",
                  "\r",
                  "if (matched) {\r",
                  "  console.log(\"Matched profile found:\", matched);\r",
                  "  // Set collection variables\r",
                  "  pm.collectionVariables.set(\"matchedProfileId\", matched.id);\r",
                  "  pm.collectionVariables.set(\"matchedProfileEmail\", matched.email);\r",
                  "  // Also store full profile JSON if needed\r",
                  "  pm.collectionVariables.set(\"matchedProfile\", JSON.stringify(matched, null, 2));\r",
                  "} else {\r",
                  "  console.log(\"No profile matched in this page.\");\r",
                  "  pm.collectionVariables.unset(\"matchedProfileId\");\r",
                  "  pm.collectionVariables.unset(\"matchedProfileEmail\");\r",
                  "  pm.collectionVariables.unset(\"matchedProfile\");\r",
                  "}\r",
                  ""
                ],
                "type": "text/javascript",
                "packages": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "https://api.squarespace.com/1.0/profiles/?customerEmail={{customerEmail}}",
              "protocol": "https",
              "host": [
                "api",
